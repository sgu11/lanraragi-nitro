<!DOCTYPE html>

<html>

<head>
    <title>[% title %] - [% c.lh("Duplicates") %]</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="apple-mobile-web-status-bar-style" content="black" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />

    <link type="image/png" rel="icon" href="favicon.ico" />
    <link rel="manifest" href="app.webappmanifest" />
    <link rel="stylesheet" type="text/css" href="[% c.url_for("/css/lrr.css?$version") %]" />
    <link rel="stylesheet" type="text/css" href="[% c.url_for("/css/duplicates.css?$version") %]" />
    <link rel="stylesheet" type="text/css" href="[% c.url_for("/css/vendor/fontawesome-all.min.css") %]" />
    <link rel="stylesheet" type="text/css" href="[% c.url_for("/css/vendor/sweetalert2.min.css") %]" />
    [% csshead %]

    <script defer src="[% c.url_for("/js/vendor/jquery.min.js") %]" type="text/JAVASCRIPT"></script>
    <script defer src="[% c.url_for("/js/vendor/preact.umd.js") %]" type="text/JAVASCRIPT"></script>
    <script defer src="[% c.url_for("/js/vendor/hooks.umd.js") %]" type="text/JAVASCRIPT"></script>
    <script defer src="[% c.url_for("/js/vendor/compat.umd.js") %]" type="text/JAVASCRIPT"></script>
    <script defer src="[% c.url_for("/js/react-alias.js?$version") %]" type="text/JAVASCRIPT"></script>
    <script defer src="[% c.url_for("/js/vendor/clsx.min.js") %]" type="text/JAVASCRIPT"></script>
    <script defer src="[% c.url_for("/js/vendor/react-toastify.umd.js") %]" type="text/JAVASCRIPT"></script>
    <script defer src="[% c.url_for("/js/vendor/sweetalert2.min.js") %]" type="text/JAVASCRIPT"></script>
    <script defer src="[% c.url_for("/js/i18n.js?$version") %]" type="text/JAVASCRIPT"></script>
    <script defer src="[% c.url_for("/js/mod/common.js?$version") %]" type="text/JAVASCRIPT"></script>
    <script defer src="[% c.url_for("/js/duplicates.js?$version") %]" type="text/JAVASCRIPT"></script>

</head>

<body>

    <div id="dupes-container" class='ido' style='margin: 20px;'>
        <h2 class='ih' style='text-align:center'>[% c.lh("Duplicates") %]</h2>

        <div id="dupes-toolbar">
            <button id="return" class="stdbtn" type="button">
                <i class="fas fa-arrow-left"></i> [% c.lh("Return to Library") %]
            </button>
            <button id="run-find" class="stdbtn" type="button">
                <i class="fas fa-search"></i> [% c.lh("Find more pairs (next deck)") %]
            </button>
            <button id="run-refresh" class="stdbtn" type="button">
                <i class="fas fa-sync"></i> [% c.lh("Refresh deck") %]
            </button>
            <button id="run-backfill" class="stdbtn" type="button">
                <i class="fas fa-cogs"></i> [% c.lh("Run backfill") %]
            </button>
            <button id="run-find-cover" class="stdbtn" type="button" title="Cover-only pass: ignores page-count gap, surfaces chapter↔volume style matches.">
                <i class="fas fa-image"></i> [% c.lh("Find by cover") %]
            </button>
            <span id="dupes-stats" class="dupes-stats">Loading…</span>
            <label class="dupes-threshold-label">
                [% c.lh("Threshold:") %]
                <input id="threshold-slider" type="range" min="12" max="25" step="1" value="22" />
                <span id="threshold-value">22</span>
                <select id="preset-select">
                    <option value="12">12 (strict)</option>
                    <option value="20">20</option>
                    <option value="22" selected>22</option>
                    <option value="25">25 (loose)</option>
                </select>
            </label>
        </div>

        <div id="dupes-list">Loading pairs…</div>
    </div>

</body>

</html>
